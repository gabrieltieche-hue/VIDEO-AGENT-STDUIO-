  "motionComponents": {
    "comp-rocket": {
      "id": "comp-rocket",
      "name": "Fusée en Décollage",
      "description": "Fusée spatiale 2D avec traînée de particules et vibration d'accélération",
      "width": 1080,
      "height": 1080,
      "fps": 30,
      "hasAlpha": true,
      "tRange": [
        0,
        1
      ],
      "code": "// Animation Fusée pilotée par window.setT(t) [0 -> 1]\nwindow.setT = function(t) {\n  const rocket = document.getElementById('rocket-body');\n  const flame = document.getElementById('rocket-flame');\n  if (!rocket) return;\n  const posY = 500 - (t * 600);\n  const shake = Math.sin(t * 80) * (3 * (1 - t));\n  rocket.style.transform = `translate3d(${shake}px, ${posY}px, 0)`;\n  if (flame) {\n    const scaleY = 0.8 + Math.sin(t * 50) * 0.4;\n    flame.style.transform = `scaleY(${scaleY})`;\n  }\n};"
    },
    "comp-chart": {
      "id": "comp-chart",
      "name": "Graphique Boursier Exponentiel",
      "description": "Courbe de croissance avec barres dynamiques et badge de pourcentage",
      "width": 1080,
      "height": 960,
      "fps": 30,
      "hasAlpha": true,
      "tRange": [
        0,
        1
      ],
      "code": "// Animation Graphique pilotée par window.setT(t)\nwindow.setT = function(t) {\n  const bars = document.querySelectorAll('.chart-bar');\n  const badge = document.getElementById('stat-badge');\n  bars.forEach((bar, index) => {\n    const progress = Math.min(1, Math.max(0, (t * 1.5) - (index * 0.15)));\n    const targetHeight = [35, 52, 70, 95, 140, 210][index] || 100;\n    (bar as HTMLElement).style.height = `${progress * targetHeight}px`;\n  });\n  if (badge) {\n    const val = Math.round(t * 342);\n    badge.innerText = `+${val}%`;\n  }\n};"
    },
    "comp-neural": {
      "id": "comp-neural",
      "name": "Réseau de Neurones Vivant",
      "description": "Noeuds connectés avec impulsions lumineuses le long des synapses",
      "width": 1080,
      "height": 960,
      "fps": 30,
      "hasAlpha": true,
      "tRange": [
        0,
        1
      ],
      "code": "// Animation Réseau de Neurones\nwindow.setT = function(t) {\n  const synapses = document.querySelectorAll('.synapse-line');\n  synapses.forEach((line, i) => {\n    const offset = (t * 100 + i * 25) % 100;\n    (line as HTMLElement).style.strokeDashoffset = `${-offset}`;\n  });\n};"
    }
  },
